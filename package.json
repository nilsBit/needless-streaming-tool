{
  "name": "needless-streaming-tool",
  "version": "1.0.4",
  "description": "Needless Streaming Tool — Stream Management App",
  "author": "nilsBit",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm run dev:renderer\" \"npm run dev:main\"",
    "dev:main": "nodemon",
    "dev:renderer": "vite",
    "build": "tsc -p tsconfig.node.json && vite build && electron-builder",
    "build:mac": "tsc -p tsconfig.node.json && vite build && electron-builder --mac",
    "build:win": "tsc -p tsconfig.node.json && vite build && electron-builder --win",
    "build:all": "tsc -p tsconfig.node.json && vite build && electron-builder --mac --win",
    "typecheck": "tsc --noEmit",
    "test": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs run",
    "test:watch": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "showcase:capture": "node scripts/showcase-capture.mjs",
    "showcase:compare": "node scripts/showcase-compare.mjs",
    "server:headless": "tsc -p tsconfig.node.json && electron scripts/server-headless.cjs",
    "ui:walk": "node scripts/ui-walk.mjs",
    "ui:flow": "node scripts/ui-flow.mjs",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@coooookies/windows-smtc-monitor": "^1.0.12",
    "@types/tmi.js": "^1.8.6",
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.8.9",
    "express": "^4.21.0",
    "obs-websocket-js": "^5.0.8",
    "tmi.js": "^1.8.5",
    "ws": "^8.21.0"
  },
  "build": {
    "appId": "com.nst.streaming-tool",
    "productName": "Needless Streaming Tool",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/overlays/**/*",
      "node_modules/**/*",
      "!node_modules/**/*.md",
      "!node_modules/**/*.ts",
      "!node_modules/**/test/**",
      "!node_modules/better-sqlite3/deps/**",
      "!node_modules/better-sqlite3/src/**",
      "!node_modules/better-sqlite3/build/**",
      "!node_modules/better-sqlite3/prebuilds/linux*"
    ],
    "electronLanguages": [
      "de",
      "en-US"
    ],
    "extraResources": [
      {
        "from": "src/overlays",
        "to": "overlays"
      },
      {
        "from": "assets",
        "to": "assets",
        "filter": [
          "*.png"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "files": [
        "!node_modules/better-sqlite3/prebuilds/win32-*"
      ],
      "icon": "assets/icon.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico",
      "files": [
        "!node_modules/better-sqlite3/prebuilds/darwin-*"
      ]
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "shortcutName": "Needless Streaming Tool",
      "artifactName": "Needless-Streaming-Tool-Setup-${version}.${ext}"
    },
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "resetAdHocDarwinSignature": true
    },
    "asarUnpack": [
      "node_modules/better-sqlite3/**",
      "node_modules/@coooookies/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "nilsBit",
        "repo": "needless-streaming-tool"
      }
    ]
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^4.17.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.5.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.57.1",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "nodemon": "^3.1.14",
    "playwright-core": "^1.64.0",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "qs": "^6.15.4"
  }
}
