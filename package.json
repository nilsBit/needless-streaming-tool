{
  "name": "needless-streaming-tool",
  "version": "1.0.0",
  "description": "Needless Streaming Tool — Stream Management App",
  "author": "nilsBit",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:main\"",
    "dev:main": "nodemon",
    "dev:renderer": "vite",
    "build:plugin": "npm --prefix streamdeck-plugin run package",
    "build": "npm run build:plugin && tsc -p tsconfig.node.json && vite build && electron-builder",
    "build:mac": "npm run build:plugin && tsc -p tsconfig.node.json && vite build && electron-builder --mac",
    "build:win": "npm run build:plugin && tsc -p tsconfig.node.json && vite build && electron-builder --win",
    "build:all": "npm run build:plugin && tsc -p tsconfig.node.json && vite build && electron-builder --mac --win",
    "typecheck": "tsc --noEmit",
    "test": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs run",
    "test:watch": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs",
    "lint": "eslint src/",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@coooookies/windows-smtc-monitor": "^1.0.12",
    "@types/tmi.js": "^1.8.6",
    "better-sqlite3": "^11.0.0",
    "express": "^4.21.0",
    "obs-websocket-js": "^5.0.8",
    "tmi.js": "^1.8.5",
    "ws": "^8.21.0"
  },
  "build": {
    "appId": "com.nst.streaming-tool",
    "productName": "Needless Streaming Tool",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/overlays/**/*",
      "node_modules/**/*",
      "!node_modules/**/*.md",
      "!node_modules/**/*.ts",
      "!node_modules/**/test/**"
    ],
    "extraResources": [
      {
        "from": "src/overlays",
        "to": "overlays"
      },
      {
        "from": "assets/com.nst.deck.streamDeckPlugin",
        "to": "assets/com.nst.deck.streamDeckPlugin"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "icon": "assets/icon.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "shortcutName": "Needless Streaming Tool"
    },
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**",
      "node_modules/@coooookies/**"
    ]
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/express": "^4.17.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.5.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.57.1",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
